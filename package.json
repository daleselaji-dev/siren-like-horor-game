{
  "name": "fanchao",
  "version": "1.0.0",
  "description": "返潮 FANCHAO — 蚀湾 2001 · 中式民俗海洋恐怖 · 类《死魂曲》第一人称潜行 Demo",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs smoke && node scripts/verify.mjs gameplay && node scripts/verify.mjs looks && node scripts/verify.mjs playthrough",
    "verify:one": "node scripts/verify.mjs",
    "desktop": "vite build && electron .",
    "dist": "vite build && electron-builder --win portable --linux AppImage",
    "dist:win": "vite build && electron-builder --win portable",
    "dist:win-zip": "vite build && electron-builder --win zip",
    "dist:linux": "vite build && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.fanchao.demo",
    "productName": "Fanchao",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Fanchao-${version}-win-portable.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "artifactName": "Fanchao-${version}-linux.AppImage"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daleselaji-dev/siren-like-horor-game.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/daleselaji-dev/siren-like-horor-game/issues"
  },
  "homepage": "https://github.com/daleselaji-dev/siren-like-horor-game#readme",
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "puppeteer-core": "^24.43.1",
    "vite": "^8.2.2"
  },
  "type": "module"
}
